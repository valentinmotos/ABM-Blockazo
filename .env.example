# Valores de ejemplo para desarrollo local. Completar en la terminal; nunca subir secretos.
DATABASE_URL=jdbc:postgresql://localhost:5432/blockazo
DATABASE_USERNAME=blockazo_app
DATABASE_PASSWORD=
JWT_SECRET=
JWT_ISSUER=http://localhost:8080
JWT_AUDIENCE=blockazo-api
COOKIE_SECURE=false
FRONTEND_URL=http://localhost:5173
GOOGLE_OAUTH_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET_B64=
